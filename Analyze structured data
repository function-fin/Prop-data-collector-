-- Identificador Preciso de Props
local function getPropInformation(part)
    if not part or not part:IsA("BasePart") then return nil, nil end

    local propFolder = Workspace:FindFirstChild("WorkspaceCom") and Workspace.WorkspaceCom:FindFirstChild("001_TrafficCones")
    local current = part
    local propInstance = nil

    while current and current ~= Workspace do
        if current:FindFirstChild("SetCurrentCFrame") or current:FindFirstChild("ChangePropColor") or (propFolder and current.Parent == propFolder) then
            propInstance = current
            break
        end
        current = current.Parent
    end

    if propInstance then
        return propInstance.Name, part
    end

    return nil, nil
end

-- Atualização da UI
local function updateUI()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    
    for i, data in ipairs(collectedData) do
        local row = Instance.new("TextLabel", scrollFrame)
        row.Size = UDim2.new(0, 930, 0, 16)
        row.BackgroundTransparency = 1
        row.Font = Enum.Font.Code
        row.TextSize = 9
        row.TextColor3 = Color3.fromRGB(255, 255, 255)
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.ZIndex = 13
        
        row.Text = string.format("[ PROP %d ]: Name: %s  |  Pos: %.3f, %.3f, %.3f  |  Rot: %.2f, %.2f, %.2f  |  Size: %.2f, %.2f, %.2f  |  Color: %d, %d, %d", 
            i, 
            data.name,
            data.pos.X, data.pos.Y, data.pos.Z, 
            data.rot.X, data.rot.Y, data.rot.Z, 
            data.size.X, data.size.Y, data.size.Z, 
            math.floor(data.color.R * 255), math.floor(data.color.G * 255), math.floor(data.color.B * 255)
        )
    end
    scrollFrame.CanvasSize = UDim2.new(0, 950, 0, #collectedData * 18)
    actionButton.Text = string.format("Data\nCollector\n( %d )", #collectedData)
end

-- Captura via Raycast
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not toolEquipped or not actionButton.Visible then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)
        local raycastParams = RaycastParams.new()
        
        local ignoreList = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(ignoreList, p.Character) end
        end
        
        raycastParams.FilterDescendantsInstances = ignoreList
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 5000, raycastParams)
        if raycastResult and raycastResult.Instance then
            local target = raycastResult.Instance
            local propName, targetPart = getPropInformation(target)
            
            if propName and targetPart then
                if selectedInstances[targetPart] then
                    return
                end
                
                selectedInstances[targetPart] = true
                
                local rx, ry, rz = targetPart.CFrame:ToOrientation()
                
                table.insert(collectedData, {
                    name = propName,
                    pos = targetPart.Position,
                    rot = Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)),
                    size = targetPart.Size,
                    color = targetPart.Color
                })
                updateUI()
            end
        end
    end
end)

