-- Função para criar Aura ESP
local function createESP(instance)
    if not instance then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SPWN_Prop_ESP"
    highlight.Adornee = instance
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.85
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = CoreGui

    table.insert(activeHighlights, highlight)
end

-- Identificador do Prop
local function getPropInformation(part)
    if not part or not part:IsA("BasePart") then return nil, nil, nil, nil end

    local current = part
    local propInstance = nil

    while current and current ~= Workspace do
        if current:FindFirstChild("SetCurrentCFrame") or current:FindFirstChild("ChangePropColor") or current.Parent == Workspace:FindFirstChild("WorkspaceCom") then
            propInstance = current
            break
        end
        current = current.Parent
    end

    if not propInstance then return nil, nil, nil, nil end

    local realPropId = propInstance:GetAttribute("id") or propInstance.Name
    return propInstance.Name, realPropId, part, propInstance
end

-- EXTRAÇÃO DO CFRAME RAIZ / MESTRE DO PROP
local function getRootCFrameAndSize(propInstance, clickedPart)
    local targetCF, targetSize, targetColor

    if propInstance:IsA("Model") then
        if propInstance.PrimaryPart then
            targetCF = propInstance.PrimaryPart.CFrame
            targetSize = propInstance.PrimaryPart.Size
            targetColor = propInstance.PrimaryPart.Color
        else
            -- Procura por uma parte com nome de raiz comum
            local rootPart = propInstance:FindFirstChild("Root") or propInstance:FindFirstChild("HumanoidRootPart") or propInstance:FindFirstChild("Main")
            if rootPart and rootPart:IsA("BasePart") then
                targetCF = rootPart.CFrame
                targetSize = rootPart.Size
                targetColor = rootPart.Color
            else
                -- BoundingBox do Modelo inteiro
                local cf, sz = propInstance:GetBoundingBox()
                targetCF = cf
                targetSize = sz
                targetColor = clickedPart and clickedPart.Color or Color3.fromRGB(255, 255, 255)
            end
        end
    elseif propInstance:IsA("BasePart") then
        targetCF = propInstance.CFrame
        targetSize = propInstance.Size
        targetColor = propInstance.Color
    else
        targetCF = clickedPart.CFrame
        targetSize = clickedPart.Size
        targetColor = clickedPart.Color
    end

    return targetCF, targetSize, targetColor
end

-- Atualização da UI
local function updateUI()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("TextBox") then child:Destroy() end
    end

    for i, data in ipairs(collectedData) do
        local rowBox = Instance.new("TextBox", scrollFrame)
        rowBox.Size = UDim2.new(1, 0, 0, 18)
        rowBox.BackgroundTransparency = 1
        rowBox.ClipsDescendants = true
        rowBox.Font = Enum.Font.Code
        rowBox.TextSize = 9
        rowBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        rowBox.TextXAlignment = Enum.TextXAlignment.Left
        rowBox.ClearTextOnFocus = false
        rowBox.TextEditable = false
        rowBox.Active = false
        rowBox.ZIndex = 13

        rowBox.Text = string.format("[ PROP %d ]: Name: %s | PropID: %s | RelPos: %.2f, %.2f, %.2f | Rot: %.1f, %.1f, %.1f | Color: %.2f, %.2f, %.2f | Dist: %.1fs", 
            i, 
            data.name,
            data.propId,
            data.pos.X, data.pos.Y, data.pos.Z, 
            data.rot.X, data.rot.Y, data.rot.Z,
            data.color.R, data.color.G, data.color.B,
            data.distance
        )

        local holdThread = nil
        rowBox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                holdThread = task.delay(2.0, function()
                    rowBox.Active = true
                    rowBox.TextEditable = true
                    rowBox:CaptureFocus()
                end)
            end
        end)

        rowBox.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if holdThread then
                    task.cancel(holdThread)
                    holdThread = nil
                end
            end
        end)

        rowBox.FocusLost:Connect(function()
            rowBox.TextEditable = false
            rowBox.Active = false
        end)
    end
    scrollFrame.CanvasSize = UDim2.new(0, 1400, 0, #collectedData * 20)
    actionButton.Text = string.format("Data\nCollector\n( %d )", #collectedData)
end

-- Processa confirmação da nomeação
local function confirmPropName()
    if pendingPropData then
        local customName = nameInput.Text
        if customName:gsub("%s+", "") ~= "" then
            pendingPropData.name = customName
        end

        createESP(pendingPropData.instance)

        selectedProps[pendingPropData.instance] = true
        pcall(function() pendingPropData.instance:SetAttribute("SPWN_Collected", true) end)

        table.insert(collectedData, pendingPropData)
        updateUI()
        pendingPropData = nil
    end
    nameModal.Visible = false
    nameInput.Text = ""
end

btnConfirmName.MouseButton1Click:Connect(confirmPropName)
nameInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then confirmPropName() end
end)

-- Captura via Raycast ao Clicar com a Tool
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not toolEquipped or not actionButton.Visible then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position

        if nameModal.Visible then
            local mPos = nameModal.AbsolutePosition
            local mSize = nameModal.AbsoluteSize
            if pos.X < mPos.X or pos.X > mPos.X + mSize.X or pos.Y < mPos.Y or pos.Y > mPos.Y + mSize.Y then
                nameModal.Visible = false
                pendingPropData = nil
            end
            return
        end

        if mainFrame.Visible then
            local fPos = mainFrame.AbsolutePosition
            local fSize = mainFrame.AbsoluteSize
            local btnPos = floatingBtn.AbsolutePosition
            local btnSize = floatingBtn.AbsoluteSize

            local insideMain = (pos.X >= fPos.X and pos.X <= fPos.X + fSize.X and pos.Y >= fPos.Y and pos.Y <= fPos.Y + fSize.Y)
            local insideBtn = (pos.X >= btnPos.X and pos.X <= btnPos.X + btnSize.X and pos.Y >= btnPos.Y and pos.Y <= btnPos.Y + btnSize.Y)

            if not insideMain and not insideBtn then
                mainFrame.Visible = false
            end
        end

        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)
        local raycastParams = RaycastParams.new()

        local ignoreList = {screenGui}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(ignoreList, p.Character) end
        end

        raycastParams.FilterDescendantsInstances = ignoreList
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 5000, raycastParams)
        if raycastResult and raycastResult.Instance then
            local target = raycastResult.Instance
            local workspaceName, realPropId, targetPart, propInstance = getPropInformation(target)

            if propInstance and not selectedProps[propInstance] and not propInstance:GetAttribute("SPWN_Collected") then
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")

                if hrp then
                    -- Busca o CFrame Mestre/Raiz e Dimensões Reais da Estrutura
                    local rootCF, rootSize, rootColor = getRootCFrameAndSize(propInstance, targetPart)

                    local basePlayerCFrame = CFrame.new(hrp.Position)
                    local relativeCF = basePlayerCFrame:ToObjectSpace(rootCF)

                    local rx, ry, rz = relativeCF:ToOrientation()
                    local distStuds = (rootCF.Position - hrp.Position).Magnitude
                    local categoria = ObterCategoria(realPropId)

                    pendingPropData = {
                        name = workspaceName,
                        propId = realPropId,
                        categoria = categoria,
                        pos = relativeCF.Position,
                        rot = Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)),
                        distance = distStuds,
                        cfComponents = {relativeCF:GetComponents()},
                        size = rootSize,
                        color = rootColor,
                        instance = propInstance
                    }

                    nameInput.Text = workspaceName .. " " .. realPropId
                    nameModal.Visible = true
                    nameInput:CaptureFocus()
                end
            end
        end
    end
end)

