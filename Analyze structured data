                        PropName = tostring(args[2] or ""),
                        SubName = tostring(args[3] or ""),
                        FullRemotePath = self:GetFullName()
                    }
                end
            end
        end
        return OldNamecall(self, ...)
    end))
    getgenv().CollectorRspyHooked = true
end

