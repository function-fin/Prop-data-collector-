-- [FIX 2] Contador valida se é prop real
local function countPlayerPropsInWorkspace(playerName)
    local propPrefix = "Prop" .. playerName
    local totalProps = 0
    local collectedCount = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == propPrefix and isValidProp(obj) then
            totalProps = totalProps + 1
            if selectedProps[obj] or obj:GetAttribute("SPWN_Collected") then
                collectedCount = collectedCount + 1
            end
        end
    end
    return totalProps, collectedCount
end

