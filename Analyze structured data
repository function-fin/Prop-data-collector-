-- PROCESSAMENTO ANCORADO (Anti-Ping / Trava de CFrame)
local function processPropSingleWithAnchor(propInstance, targetPart, originPivot)
    if not propInstance or selectedProps[propInstance] or propInstance:GetAttribute("SPWN_Collected") then return false end
    if not isValidProp(propInstance) then return false end
    
    local workspaceName, realPropId = getPropInformation(targetPart or propInstance)
    workspaceName = workspaceName or propInstance.Name
    realPropId = realPropId or propInstance.Name

    if originPivot then
        local rootCF, rootSize, rootColor = getRootCFrameAndSize(propInstance, targetPart)
        
        local relativeCF = originPivot:ToObjectSpace(rootCF)
        local rx, ry, rz = relativeCF:ToOrientation()
        local distStuds = (rootCF.Position - originPivot.Position).Magnitude
        local categoria = ObterCategoria(realPropId)

        local propData = {
            name = workspaceName,
            propId = realPropId,
            categoria = categoria,
            pos = relativeCF.Position,
            rot = Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)),
            distance = distStuds,
            cfComponents = {relativeCF:GetComponents()},
            size = rootSize,
            color = rootColor,
            instance = propInstance
        }

        createESP(propInstance)
        selectedProps[propInstance] = true
        pcall(function() propInstance:SetAttribute("SPWN_Collected", true) end)
        table.insert(collectedData, propData)
        return true
    end
    return false
end

-- MATRIZ DE INVOCAÇÃO CIRCULAR (500 Pontos a 0.72 Degrees)
local function GenerateInvocationCircle(originPivot, radius)
    radius = radius or SPWN_Config.RadiusStuds
    local circlePoints = {}

    for i = 1, SPWN_Config.TotalCirclePoints do
        local angleRad = math.rad((i - 1) * SPWN_Config.AngleStep)
        local xOffset = math.cos(angleRad) * radius
        local zOffset = math.sin(angleRad) * radius

        local pointCFrame = originPivot * CFrame.new(xOffset, 0, zOffset) * CFrame.Angles(0, -angleRad, 0)
        table.insert(circlePoints, {
            Index = i,
            Angle = (i - 1) * SPWN_Config.AngleStep,
            CFrame = pointCFrame
        })
    end

    return circlePoints
end

-- COPY ALL CADENCIADO E ANCORADO (Handshake Step-by-Step)
btnCopyAll.MouseButton1Click:Connect(function()
    if isProcessingAll then return end
    if not selectedTargetPlayer then
        btnCopyAll.Text = "SELECT PLR!"
        task.wait(1)
        btnCopyAll.Text = "Copy all"
        return
    end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    isProcessingAll = true
    
    local originPivot = hrp.CFrame
    local targetName = selectedTargetPlayer.Name
    local propPrefix = "Prop" .. targetName

    local propsToProcess = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == propPrefix and isValidProp(obj) then
            if not selectedProps[obj] and not obj:GetAttribute("SPWN_Collected") then
                table.insert(propsToProcess, obj)
            end
        end
    end

    local total = #propsToProcess
    if total == 0 then
        btnCopyAll.Text = "NO PROPS!"
        task.wait(1)
        btnCopyAll.Text = "Copy all"
        isProcessingAll = false
        return
    end

    local addedCount = 0
    for i, propObj in ipairs(propsToProcess) do
        local success = processPropSingleWithAnchor(propObj, nil, originPivot)
        if success then
            addedCount = addedCount + 1
        end

        btnCopyAll.Text = string.format("COPY %d/%d", i, total)

        if i % 5 == 0 then
            updateUI()
            task.wait(SPWN_Config.StepDelay)
        end
    end

    updateUI()
    btnCopyAll.Text = string.format("DONE (+%d)!", addedCount)
    task.wait(1.5)
    btnCopyAll.Text = "Copy all"
    isProcessingAll = false
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not toolEquipped then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position

        if nameModal.Visible then
            local mPos = nameModal.AbsolutePosition
            local mSize = nameModal.AbsoluteSize
            if pos.X < mPos.X or pos.X > mPos.X + mSize.X or pos.Y < mPos.Y or pos.Y > mPos.Y + mSize.Y then
                nameModal.Visible = false
                pendingPropData = nil
            end
            return
        end

        if mainFrame.Visible then
            local fPos = mainFrame.AbsolutePosition
            local fSize = mainFrame.AbsoluteSize
            local btnPos = floatingBtn.AbsolutePosition
            local btnSize = floatingBtn.AbsoluteSize

            local insideMain = (pos.X >= fPos.X and pos.X <= fPos.X + fSize.X and pos.Y >= fPos.Y and pos.Y <= fPos.Y + fSize.Y)
            local insideBtn = (pos.X >= btnPos.X and pos.X <= btnPos.X + btnSize.X and pos.Y >= btnPos.Y and pos.Y <= btnPos.Y + btnSize.Y)

            if not insideMain and not insideBtn then
                mainFrame.Visible = false
            end
        end

        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)
        local ignoreList = {screenGui}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then table.insert(ignoreList, p.Character) end
        end

        local raycastResult = performRaycast(unitRay.Origin, unitRay.Direction, ignoreList)

        if raycastResult and raycastResult.Instance then
            local targetPart = raycastResult.Instance
            local workspaceName, realPropId, targetPartValid, propInstance = getPropInformation(targetPart)

            if propInstance and not selectedProps[propInstance] and not propInstance:GetAttribute("SPWN_Collected") then
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")

                if hrp then
                    local rootCF, rootSize, rootColor = getRootCFrameAndSize(propInstance, targetPartValid or targetPart)
                    local relativeCF = hrp.CFrame:ToObjectSpace(rootCF)
                    local rx, ry, rz = relativeCF:ToOrientation()
                    local distStuds = (rootCF.Position - hrp.Position).Magnitude
                    local categoria = ObterCategoria(realPropId)

                    pendingPropData = {
                        name = workspaceName,
                        propId = realPropId,
                        categoria = categoria,
                        pos = relativeCF.Position,
                        rot = Vector3.new(math.deg(rx), math.deg(ry), math.deg(rz)),
                        distance = distStuds,
                        cfComponents = {relativeCF:GetComponents()},
                        size = rootSize,
                        color = rootColor,
                        instance = propInstance
                    }

                    nameInput.Text = workspaceName .. " " .. realPropId
                    nameModal.Visible = true
                    nameInput:CaptureFocus()
                end
            end
        end
    end
end)

