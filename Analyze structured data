-- [FIX 2] Helper: verifica se um objeto é realmente um PROP válido
local function isValidProp(instance)
    if not instance then return false end
    if not (instance:IsA("Model") or instance:IsA("BasePart")) then return false end

    if instance:FindFirstChild("SetCurrentCFrame", true) or instance:FindFirstChild("ChangePropColor", true) then
        return true
    end

    local wsCom = Workspace:FindFirstChild("WorkspaceCom")
    if wsCom and instance.Parent == wsCom then
        return true
    end

    if instance:GetAttribute("id") ~= nil then
        return true
    end

    return false
end
