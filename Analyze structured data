-- [FIX 2] getPropInformation agora SÓ retorna props válidos
local function getPropInformation(part)
    if not part then return nil, nil, nil, nil end

    local current = part
    local propInstance = nil

    while current and current ~= Workspace do
        if isValidProp(current) then
            propInstance = current
            break
        end
        current = current.Parent
    end

    if not propInstance then
        return nil, nil, nil, nil
    end

    local realPropId = propInstance:GetAttribute("id") or propInstance.Name
    return propInstance.Name, realPropId, part, propInstance
end

local function findPropColor(propInstance, clickedPart)
    if not propInstance then return Color3.fromRGB(255, 255, 255) end

    if clickedPart and clickedPart:IsA("BasePart") then
        local c = clickedPart.Color
        local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
        if not (r == 40 and g == 40 and b == 40) then
            return clickedPart.Color
        end
    end

    local attrColor = propInstance:GetAttribute("Color") or propInstance:GetAttribute("PropColor") or propInstance:GetAttribute("PaintColor")
    if attrColor and typeof(attrColor) == "Color3" then
        return attrColor
    end

    for _, obj in ipairs(propInstance:GetDescendants()) do
        if obj:IsA("BasePart") and (obj:FindFirstChild("ColorChange") or obj.Name == "Touch") then
            local c = obj.Color
            local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
            if not (r == 40 and g == 40 and b == 40) then
                return obj.Color
            end
        end
    end

    for _, part in ipairs(propInstance:GetDescendants()) do
        if part:IsA("BasePart") then
            local c = part.Color
            local r, g, b = math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
            if not (r == 40 and g == 40 and b == 40) then
                return part.Color
            end
        end
    end

    return Color3.fromRGB(255, 255, 255)
end

local function getRootCFrameAndSize(propInstance, clickedPart)
    local targetCF, targetSize
    local targetColor = findPropColor(propInstance, clickedPart)

    if propInstance:IsA("Model") then
        if propInstance.PrimaryPart then
            targetCF = propInstance.PrimaryPart.CFrame
            targetSize = propInstance.PrimaryPart.Size
        else
            local cf, sz = propInstance:GetBoundingBox()
            targetCF = cf
            targetSize = sz
        end
    elseif propInstance:IsA("BasePart") then
        targetCF = propInstance.CFrame
        targetSize = propInstance.Size
    else
        targetCF = clickedPart and clickedPart.CFrame or CFrame.new()
        targetSize = clickedPart and clickedPart.Size or Vector3.new(1, 1, 1)
    end

    return targetCF, targetSize, targetColor
end

local function performRaycast(origin, direction, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local maxDistance = 5000
    local result = Workspace:Raycast(origin, direction * maxDistance, raycastParams)
    return result
end

